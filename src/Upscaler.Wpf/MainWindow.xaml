<Window x:Class="Upscaler.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Local AI Upscaler" Width="1440" Height="900" MinWidth="1100" MinHeight="700" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
<Grid Margin="16" TextElement.Foreground="{StaticResource ForegroundBrush}" TextElement.FontSize="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,12"><TextBlock Text="LOCAL AI UPSCALER" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="폴더 열기" Click="OpenFolder"/><Button Content="새로고침" Click="RefreshFolder"/><Button Content="설정" Click="ShowSettings"/></StackPanel></DockPanel>
<DockPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="←" Click="GoBack"/><Button Content="→" Click="GoForward"/><Button Content="↑" Click="GoUp"/><TextBox DockPanel.Dock="Right" Width="180" Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" ToolTip="파일명 검색"/><TextBox x:Name="Address" Text="{Binding Address,UpdateSourceTrigger=PropertyChanged}" KeyDown="AddressKey"/></DockPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="220" MinWidth="140"/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="폴더" FontWeight="SemiBold" Margin="6,4,0,12"/><TreeView x:Name="Folders" SelectedItemChanged="FolderSelected"/></DockPanel></Border>
<GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#30384A"/>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="6"/><RowDefinition x:Name="ThumbnailRow" Height="170" MinHeight="100"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
<Border Background="#0D1118" CornerRadius="8" Margin="6,0,12,0"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8"><Button Content="−" Click="ZoomOut"/><Button Content="화면 맞춤" Click="Fit"/><Button Content="+" Click="ZoomIn"/><TextBlock Text="{Binding ImageInfo}" VerticalAlignment="Center" Margin="12,0"/></StackPanel><ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PreviewWheel" MouseLeftButtonDown="PreviewDown" MouseMove="PreviewMove" MouseLeftButtonUp="PreviewUp"><Grid><TextBlock Text="{Binding PreviewMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8997AE"/><Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></ScrollViewer></DockPanel></Border>
<Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Separator Margin="0,16"/><Button Content="현재 이미지 실행" Click="RunImage" IsEnabled="{Binding HasSelection}" Background="#3769AA"/><Button Content="현재 폴더 실행" Click="RunFolder" IsEnabled="{Binding HasFiles}"/><Button Content="최근 결과 보기" Click="ShowResult"/></StackPanel><ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="업스케일 설정" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Real-ESRGAN x4plus" Margin="0,20,0,6"/><TextBlock Text="가로 · 세로 4배" Foreground="#92A2BC" Margin="0,0,0,20"/><TextBlock Text="실행 장치"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Device}"/><TextBlock Text="정밀도" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Precisions}" SelectedItem="{Binding Precision}"/><TextBlock Text="타일 크기 (0 = 자동)" Margin="0,10,0,0"/><TextBox Text="{Binding TileText,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="출력 형식" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/><TextBlock Text="출력 폴더" Margin="0,10,0,0"/><TextBox Text="{Binding Output}" TextWrapping="Wrap"/><Button Content="출력 폴더 선택" Click="ChooseOutput"/></StackPanel></ScrollViewer></DockPanel></Border>
</Grid>
<GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#30384A"/>
<Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8"><ListBox x:Name="Thumbnails" ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="140" Margin="4"><Border Height="105" Background="#101722"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded" DataContextChanged="ThumbnailChanged" ToolTip="{Binding Error}"/></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="2,8" ToolTip="{Binding Path}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
</Grid></Grid>
<DockPanel Grid.Row="3" Margin="4,12,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding EngineStatus}" Foreground="#A5B2C7" Margin="16,0,0,0"/><TextBlock Text="{Binding Status}" Foreground="#A5B2C7" TextTrimming="CharacterEllipsis"/></DockPanel>
</Grid></Window>
